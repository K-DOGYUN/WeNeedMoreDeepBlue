<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- The directional MoyoFish_FleshMass1 growth textures render invisible in the cultivation tank. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/Moyo2.FishDef[defName="Moyo2_FleshMass"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>Defs/Moyo2.FishDef[defName="Moyo2_FleshMass"]/fishTankSettings/graphicData/texPath</xpath>
          <value>
            <texPath>Pawn/FleshMass/MoyoFish_FleshMass</texPath>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/Moyo2.FishDef[defName="Moyo2_FleshMass"]/fishTankSettings/graphicData/graphicClass</xpath>
          <value>
            <graphicClass>Graphic_Single</graphicClass>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/Moyo2.FishDef[defName="Moyo2_FleshMass"]/fishTankSettings/graphicData/drawSize</xpath>
          <value>
            <drawSize>2</drawSize>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
