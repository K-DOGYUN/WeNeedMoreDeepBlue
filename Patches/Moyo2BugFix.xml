<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- 모요 배양체의 이미지 투명도 수정 
		모요 배양체의 배양기내 이미지의 투명도가 낮아 컷오프 되어 렌더링 되지않던 문제가 있었음 -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/Moyo2.FishDef[defName="Moyo2_FleshMass"]</xpath>
		<match Class="PatchOperationSequence">
			<operations>
				<li Class="PatchOperationReplace">
					<xpath>Defs/Moyo2.FishDef[defName="Moyo2_FleshMass"]/fishTankSettings/graphicData/texPath</xpath>
					<value>
						<texPath>Pawn/MoyoFleshMassPatch/MoyoFix_FleshMass1</texPath>
					</value>
				</li>
			</operations>
		</match>
	</Operation>
</Patch>
